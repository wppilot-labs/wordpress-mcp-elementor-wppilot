{
    "slug": "backup-status",
    "version": "1.0.0",
    "namespace": "WPPilot\\Kits\\BackupStatus",
    "tier": "free",
    "runtime": "^1.2",
    "requires": {
        "php": "8.0",
        "wp": "6.9",
        "vendor_floors": {
            "UpdraftPlus": "1.26",
            "Duplicator": "5.0",
            "BackWPup": "5.7",
            "All-in-One WP Migration": "7.112"
        },
        "any": {
            "constants": [
                "UPDRAFTPLUS_DIR"
            ],
            "classes": [
                "UpdraftPlus",
                "BackWPup",
                "Duplicator\\Package\\DupPackage",
                "Ai1wm_Backups"
            ]
        }
    },
    "vendor_storage": {
        "option": [
            "backwpup_cfg_logfolder"
        ],
        "cron": [
            "backwpup_cron",
            "updraft_backup",
            "updraft_backup_database"
        ]
    },
    "categories": {
        "backups": {
            "label": "Backups",
            "description": "Read the site's backups from UpdraftPlus, Duplicator, BackWPup and All-in-One WP Migration (whichever are active): the last backup and whether it worked, what it contained, its size, whether one is running, the next scheduled one and where archives are stored. Read-only: never restores, downloads or deletes, and never returns archive paths, download links or storage credentials."
        }
    },
    "abilities": [
        {
            "name": "wppilot/backup-status",
            "readonly": true,
            "destructive": false,
            "ledger": "self"
        },
        {
            "name": "wppilot/backup-list",
            "readonly": true,
            "destructive": false,
            "ledger": "self"
        }
    ],
    "skills": [
        "backup-status"
    ],
    "tests": [
        "tests/Unit/Kits/BackupStatus"
    ]
}
