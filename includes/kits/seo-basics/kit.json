{
    "slug": "seo-basics",
    "version": "1.0.0",
    "namespace": "WPPilot\\Kits\\SeoBasics",
    "tier": "free",
    "runtime": "^1.2",
    "requires": {
        "php": "8.0",
        "wp": "6.9",
        "any": {
            "constants": [
                "WPSEO_VERSION",
                "RANK_MATH_VERSION",
                "AIOSEO_VERSION",
                "SEOPRESS_VERSION",
                "THE_SEO_FRAMEWORK_VERSION",
                "SLIM_SEO_VER",
                "SMARTCRAWL_VERSION"
            ],
            "classes": [
                "SmartCrawl\\SmartCrawl"
            ]
        }
    },
    "vendor_storage": {
        "meta": [
            "_yoast_wpseo_title",
            "_yoast_wpseo_metadesc",
            "_yoast_wpseo_meta-robots-noindex",
            "_yoast_wpseo_meta-robots-nofollow",
            "rank_math_title",
            "rank_math_description",
            "rank_math_robots",
            "_seopress_titles_title",
            "_seopress_titles_desc",
            "_seopress_robots_index",
            "_seopress_robots_follow",
            "_genesis_title",
            "_genesis_description",
            "_genesis_noindex",
            "_genesis_nofollow",
            "slim_seo",
            "_wds_title",
            "_wds_metadesc",
            "_wds_meta-robots-noindex",
            "_wds_meta-robots-index",
            "_wds_meta-robots-nofollow",
            "_wds_meta-robots-follow"
        ],
        "option": [
            "seopress_titles_option_name"
        ]
    },
    "categories": {
        "seo": {
            "label": "SEO",
            "description": "One post's SEO title, meta description and robots (index and follow) in whichever SEO plugin the site runs: Yoast SEO, Rank Math, All in One SEO, SEOPress, The SEO Framework, Slim SEO or SmartCrawl. Every write is recorded with a before-image the Changes screen can restore."
        }
    },
    "abilities": [
        {
            "name": "wppilot/yoast-get-post-seo",
            "readonly": true,
            "destructive": false,
            "ledger": "self"
        },
        {
            "name": "wppilot/yoast-edit-post-seo",
            "readonly": false,
            "destructive": false,
            "ledger": "restore:kits/post-partial"
        },
        {
            "name": "wppilot/rank-math-get-post-seo",
            "readonly": true,
            "destructive": false,
            "ledger": "self"
        },
        {
            "name": "wppilot/rank-math-edit-post-seo",
            "readonly": false,
            "destructive": false,
            "ledger": "restore:kits/post-partial"
        },
        {
            "name": "wppilot/aioseo-get-post-seo",
            "readonly": true,
            "destructive": false,
            "ledger": "self"
        },
        {
            "name": "wppilot/aioseo-edit-post-seo",
            "readonly": false,
            "destructive": false,
            "ledger": "restore:kits/seo-basics-aioseo"
        },
        {
            "name": "wppilot/seopress-get-post-seo",
            "readonly": true,
            "destructive": false,
            "ledger": "self"
        },
        {
            "name": "wppilot/seopress-edit-post-seo",
            "readonly": false,
            "destructive": false,
            "ledger": "restore:kits/post-partial"
        },
        {
